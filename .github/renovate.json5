{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    ':semanticCommits',
    'helpers:pinGitHubActionDigests',
  ],
  timezone: 'Asia/Tokyo',
  schedule: [
    'before 9am',
  ],
  minimumReleaseAge: '7 days',
  labels: [
    'dependencies',
  ],
  dependencyDashboard: {
    enabled: true,
  },
  automerge: false,
  platformAutomerge: false,
  automergeType: 'pr',
  automergeStrategy: 'merge-commit',
  lockFileMaintenance: {
    enabled: true,
    schedule: [
      'before 9am on monday',
    ],
    automerge: true,
  },
  vulnerabilityAlerts: {
    labels: [
      'dependencies',
      'security',
    ],
  },
  osvVulnerabilityAlerts: true,
  'pip-compile': {
    managerFilePatterns: [
      '/(^|/)build-constraints\\.txt$/',
    ],
  },
  customManagers: [
    {
      customType: 'regex',
      description: 'The uv of CI, in UV_VERSION of the workflows (#18).',
      managerFilePatterns: [
        '/^\\.github/workflows/[^/]+\\.ya?ml$/',
      ],
      matchStrings: [
        'UV_VERSION: "(?<currentValue>[^"]+)"',
      ],
      depNameTemplate: 'uv',
      datasourceTemplate: 'pypi',
    },
  ],
  packageRules: [
    {
      matchUpdateTypes: [
        'minor',
        'patch',
        'digest',
      ],
      minimumReleaseAge: '0 days',
      schedule: [
        'at any time',
      ],
    },
    {
      matchManagers: [
        'pep621',
      ],
      matchDepTypes: [
        'dependency-groups',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      groupName: 'Python development tools',
      automerge: true,
    },
    {
      matchManagers: [
        'pep621',
      ],
      matchDepTypes: [
        'project.dependencies',
        'project.optional-dependencies',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      groupName: 'Python dependencies',
    },
    {
      matchManagers: [
        'github-actions',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
        'digest',
      ],
      groupName: 'GitHub Actions',
      automerge: true,
    },
    {
      matchManagers: [
        'custom.regex',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      groupName: 'uv',
      automerge: true,
    },
    {
      matchManagers: [
        'pip-compile',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
        'lockFileMaintenance',
      ],
      groupName: 'build constraints',
      automerge: false,
    },
    {
      matchManagers: [
        'pyenv',
      ],
      enabled: false,
    },
    {
      matchDepTypes: [
        'requires-python',
      ],
      enabled: false,
    },
  ],
}
