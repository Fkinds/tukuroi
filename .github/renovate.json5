// Renovate keeps the dependencies up to date (#7), in place of Dependabot.
// The Renovate app of Mend runs it: CONTRIBUTING.md has what it updates.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    // Commits and titles as Conventional Commits (#24): "chore(deps): ...".
    ":semanticCommits",
    // The actions stay pinned to full commit SHAs, with the version in a
    // comment (#16).
    "helpers:pinGitHubActionDigests",
  ],
  timezone: "Asia/Tokyo",
  // Each day (#164).
  schedule: ["before 9am"],
  // A version only once it has been public for 7 days: most of the bad ones
  // are taken down by then (#7, as #18).
  minimumReleaseAge: "7 days",
  labels: ["dependencies"],
  dependencyDashboard: true,
  // Renovate merges the updates that packageRules allow (#164), itself: once
  // every check of the pull request passes, Audit and CodeQL too, and it is
  // up to date with main. The auto-merge of GitHub would wait for the checks
  // that the ruleset requires only.
  automerge: false,
  platformAutomerge: false,
  automergeType: "pr",
  // The only way that the ruleset of main allows.
  automergeStrategy: "merge-commit",
  // uv.lock and build-constraints.txt, with the versions of what they pin
  // that pyproject.toml does not name.
  lockFileMaintenance: {
    enabled: true,
    schedule: ["before 9am on monday"],
    automerge: true,
  },
  // The fixes of the vulnerabilities that GitHub finds: not Dependabot's.
  vulnerabilityAlerts: {
    labels: ["dependencies", "security"],
  },
  // And of those that osv.dev has (#25), for what Renovate reads: the
  // dependencies of pyproject.toml, build-constraints.txt, which `make audit`
  // does not check, and uv. An experimental feature of Renovate.
  osvVulnerabilityAlerts: true,
  // The build backend of the release build, which `make lock` writes with
  // `uv pip compile` (#18).
  "pip-compile": {
    managerFilePatterns: ["/(^|/)build-constraints\\.txt$/"],
  },
  customManagers: [
    {
      customType: "regex",
      description: "The uv of CI, in UV_VERSION of the workflows (#18).",
      managerFilePatterns: ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      matchStrings: ['UV_VERSION: "(?<currentValue>[^"]+)"'],
      depNameTemplate: "uv",
      datasourceTemplate: "pypi",
    },
  ],
  packageRules: [
    // One pull request for the updates that are not major, of each kind; a
    // major update has one of its own, merged by hand. The kinds that Renovate
    // merges are apart from those merged by hand (#164).
    {
      // The tools to develop tukuroi with: merged by Renovate.
      matchManagers: ["pep621"],
      matchDepTypes: ["dependency-groups"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "Python development tools",
      automerge: true,
    },
    {
      // The dependencies of the package, which reach its users: by hand.
      matchManagers: ["pep621"],
      matchDepTypes: ["project.dependencies", "project.optional-dependencies"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "Python dependencies",
    },
    {
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      groupName: "GitHub Actions",
      automerge: true,
    },
    {
      matchManagers: ["custom.regex"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "uv",
      automerge: true,
    },
    {
      // By hand until a pull request has shown that the hashes stay
      // (--generate-hashes, #18), then by Renovate.
      matchManagers: ["pip-compile"],
      matchUpdateTypes: ["minor", "patch", "lockFileMaintenance"],
      groupName: "build constraints",
      automerge: false,
    },
    // Lower bounds that the project chooses, not versions to keep up with:
    // the versions of Python (.python-version, requires-python).
    {
      matchManagers: ["pyenv"],
      enabled: false,
    },
    {
      matchDepTypes: ["requires-python"],
      enabled: false,
    },
  ],
}
